<?xml version="1.0" encoding="utf-8"?>
<!-- NotesActivity screen: option buttons restyled as white cards to match the
     approved chapter-card language; chapter lists use the card RecyclerView
     below (chapterCardList), shown only for the Notes chapter branch. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/edu_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/header"/>

        <TextView
            android:id="@+id/tvNotesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chapters"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:padding="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chapterCardList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:visibility="gone" />

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 1"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 2"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 4"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 5"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 6"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 7"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 8"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 9"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 10"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCh11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 11"
                android:textStyle="bold"
                android:textColor="@color/edu_text_primary"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/edu_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
