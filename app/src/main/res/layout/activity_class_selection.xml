<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/white">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="رَّبِّ زِدْنِي عِلْمًا"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Title Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectClass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Your Class"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="20dp"
        app:elevation="6dp"/>

    <!-- Class Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClass9"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Class 9"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="20dp"
        app:elevation="4dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClass10"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Class 10"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="20dp"
        app:elevation="4dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClass11"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Class 11"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="20dp"
        app:elevation="4dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClass12"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Class 12"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:cornerRadius="20dp"
        app:elevation="4dp"/>
</LinearLayout>
