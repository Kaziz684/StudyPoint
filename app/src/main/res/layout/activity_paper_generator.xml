<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/edu_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnBackPaper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StudyPoint"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paper Generator"
                android:textColor="#A7F3D0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollPaper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Step header -->
            <TextView
                android:id="@+id/tvStepTitlePaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 4 — Select Class, Subject &amp; Chapters"
                android:textColor="@color/edu_navy"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepSubPaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose the class and subject for your test paper."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/stepSeg1Paper"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#2563EB" />

                <View
                    android:id="@+id/stepSeg2Paper"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

                <View
                    android:id="@+id/stepSeg3Paper"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

                <View
                    android:id="@+id/stepSeg4Paper"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <!-- ================= STEP 1: Class, Subject, Chapters ================= -->
            <LinearLayout
                android:id="@+id/step1Paper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Class -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Class" />

            <Spinner
                android:id="@+id/spinnerClassPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:padding="10dp" />

            <!-- Subject -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Subject" />

            <Spinner
                android:id="@+id/spinnerSubjectPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:padding="10dp" />

            <!-- Chapters -->
            <LinearLayout
                android:id="@+id/layoutChapterSectionPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Chapter Selection" />

            <ProgressBar
                android:id="@+id/progressPaper"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvChapterStatusPaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <CheckBox
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                android:id="@+id/checkAllChaptersPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="All Chapters / Full Book"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutChaptersPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            </LinearLayout>

            </LinearLayout>

            <!-- ================= STEP 2: Paper Type & Questions ================= -->
            <LinearLayout
                android:id="@+id/step2Paper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Paper Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Paper Type" />

            <RadioGroup
                android:id="@+id/radioTypeGroupPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioTypeMcqs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/type_card_selector"
                    android:button="@null"
                    android:checked="true"
                    android:padding="14dp"
                    android:text="MCQs Test — Multiple choice questions"
                    android:textSize="15sp" />

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioTypeShort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/type_card_selector"
                    android:button="@null"
                    android:padding="14dp"
                    android:text="Short Questions — Short answer format"
                    android:textSize="15sp" />

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioTypeLong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/type_card_selector"
                    android:button="@null"
                    android:padding="14dp"
                    android:text="Long Questions — Detailed answers"
                    android:textSize="15sp" />

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioTypeCombined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/type_card_selector"
                    android:button="@null"
                    android:padding="14dp"
                    android:text="Mixed Paper — MCQs + Short + Long"
                    android:textSize="15sp" />

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioTypeBoard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/type_card_selector"
                    android:button="@null"
                    android:padding="14dp"
                    android:text="Board Pattern Paper (Eng 10/11, Chem 10, Tarjuma 10, Phy 12, CS 9)"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvBoardInfoPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field_bg"
                android:padding="10dp"
                android:text="Board Pattern"
                android:textColor="#334155"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Selection Mode -->
            <LinearLayout
                android:id="@+id/layoutModeSectionPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Selection Mode" />

            <RadioGroup
                android:id="@+id/radioModeGroupPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                    android:id="@+id/radioModeManualPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Manual — read and select questions yourself" />

                <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                    android:id="@+id/radioModeAutoPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automatic — by number of questions" />
            </RadioGroup>

            <!-- Automatic mode options -->
            <LinearLayout
                android:id="@+id/layoutAutoPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/edu_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="Number of Questions" />

                <RadioGroup
                    android:id="@+id/radioCountGroupPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                        android:id="@+id/radioAllPaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Generate all available questions" />

                    <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                        android:id="@+id/radioCustomPaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select the number of questions" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MCQs count"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                    android:id="@+id/etCustomCountPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/input_field_bg"
                    android:enabled="false"
                    android:hint="Number of MCQs, e.g. 25"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Short Questions count"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                    android:id="@+id/etCountShortPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/input_field_bg"
                    android:enabled="false"
                    android:hint="Number of Short Questions, e.g. 10"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Long Questions count"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                    android:id="@+id/etCountLongPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/input_field_bg"
                    android:enabled="false"
                    android:hint="Number of Long Questions, e.g. 5"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/edu_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="Automatic Selection" />

                <RadioGroup
                    android:id="@+id/radioSelectGroupPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                        android:id="@+id/radioSelectFirstPaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="First questions in original order" />

                    <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                        android:id="@+id/radioSelectRandomPaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Random selection (no repeats)" />
                </RadioGroup>
            </LinearLayout>

            <!-- Manual mode: question browser -->
            <LinearLayout
                android:id="@+id/layoutManualPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/edu_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="Select Questions" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Read each question and tick the ones to include. Only ticked questions will be added to the paper."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                        android:id="@+id/etSearchPaper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/input_field_bg"
                        android:hint="Search questions..."
                        android:inputType="text"
                        android:padding="10dp"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnClearSearchPaper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#64748B"
                        android:text="Clear"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutQuestionsPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            </LinearLayout>

            </LinearLayout>

            <!-- ================= STEP 3: Paper Options ================= -->
            <LinearLayout
                android:id="@+id/step3Paper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Answer key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Paper Mode" />

            <RadioGroup
                android:id="@+id/radioAnswerGroupPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                    android:id="@+id/radioUnsolvedPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Unsolved (no answers)" />

                <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                    android:id="@+id/radioSolvedPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solved (with answers)" />
            </RadioGroup>

            <!-- Order -->
            <LinearLayout
                android:id="@+id/layoutOrderSectionPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Question Order" />

            <RadioGroup
                android:id="@+id/radioOrderGroupPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioOriginalPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Original order" />

                <RadioButton
                    android:textColor="#1F2937"
                    android:id="@+id/radioRandomPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Random order (shuffle selected)" />
            </RadioGroup>

            </LinearLayout>

            <!-- Test title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Test Title" />

            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etPaperTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:hint="Question Paper"
                android:padding="12dp"
                android:text="Question Paper"
                android:textSize="15sp" />

            <!-- Time allowed -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Time Allowed" />

            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etTimePaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:hint="e.g. 1 Hour"
                android:padding="12dp"
                android:text="30 Minutes"
                android:textSize="15sp" />

            <!-- Paper header (school) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Paper Header (School)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:text="Printed at the top of every generated paper. Saved automatically." />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/edu_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="School Name" />
            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etSchoolName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:hint="School name"
                android:padding="12dp"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/edu_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Address" />
            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etSchoolAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:hint="School address"
                android:padding="12dp"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/edu_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Phone" />
            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etSchoolPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:inputType="phone"
                android:hint="Phone number"
                android:padding="12dp"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/edu_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Paper Code" />
            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etPaperCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:hint="Optional"
                android:padding="12dp"
                android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/edu_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Passing Marks" />
            <EditText
                    android:textColor="#1F2937"
                    android:textColorHint="#94A3B8"
                android:id="@+id/etPassingMarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:inputType="number"
                android:hint="Optional"
                android:padding="12dp"
                android:textSize="15sp" />

                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/edu_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="School Logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSchoolLogo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/input_field_bg"
                    android:padding="4dp"
                    android:scaleType="centerCrop" />

                <Button
                    android:id="@+id/btnPickLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Choose Logo" />

                <Button
                    android:id="@+id/btnRemoveLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Remove" />
            </LinearLayout>

            </LinearLayout>

            <!-- ================= STEP 4: Preview & Generate ================= -->
            <LinearLayout
                android:id="@+id/step4Paper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Review your selections" />

            <TextView
                android:id="@+id/tvSummaryPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field_bg"
                android:lineSpacingMultiplier="1.25"
                android:padding="14dp"
                android:textColor="#334155"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/edu_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Format" />

            <RadioGroup
                android:id="@+id/radioFormatGroupPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                    android:id="@+id/radioFormatPdfPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="PDF" />

                <RadioButton
                    android:textColor="@color/radio_text_selector"
                    android:buttonTint="@color/radio_text_selector"
                    android:id="@+id/radioFormatDocxPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MS Word (.docx)" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap Generate Paper below to create the paper. After generation you can preview, share or save it."
                android:textColor="#64748B"
                android:textSize="12.5sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom bar: step navigation + generate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutStepNavPaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackStepPaper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/edu_navy"
                android:padding="12dp"
                android:text="← Back"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextStepPaper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_green"
                android:padding="12dp"
                android:text="Next →"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGeneratePaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary_green"
            android:padding="12dp"
            android:text="Generate Paper PDF"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPaperStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#334155"
            android:textSize="13sp" />

        <!-- Actions after generation -->
        <LinearLayout
            android:id="@+id/layoutActionsPaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreviewPaper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/edu_navy"
                    android:text="Preview Paper"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnSharePaper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/edu_navy"
                    android:text="Share PDF"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSavePaper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/edu_navy"
                    android:text="Download / Save PDF"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnRegeneratePaper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/edu_navy"
                    android:text="Regenerate Test"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
