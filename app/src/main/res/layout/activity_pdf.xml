<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/edu_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar / Toolbar with Jump to Page -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/edu_navy"
            android:elevation="4dp">

            <!-- Normal Toolbar State -->
            <RelativeLayout
                android:id="@+id/layoutStandardToolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/btnJumpToPage"
                    android:layout_toEndOf="@id/btnBack"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/headerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="PDF Document"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnJumpToPage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search / Jump to Page"
                    android:src="@drawable/ic_search_page"
                    app:tint="@color/white" />

            </RelativeLayout>

            <!-- Search / Jump to Page Input Bar -->
            <RelativeLayout
                android:id="@+id/layoutPageSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/edu_navy"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Jump Search"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />

                <EditText
                    android:id="@+id/etPageNumber"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="8dp"
                    android:layout_toStartOf="@id/btnGoToPage"
                    android:layout_toEndOf="@id/btnCloseSearch"
                    android:background="@drawable/button_background"
                    android:backgroundTint="#1E293B"
                    android:gravity="center_vertical"
                    android:hint="Enter page number..."
                    android:imeOptions="actionGo"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoToPage"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:minWidth="60dp"
                    android:text="Go"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/edu_blue"
                    app:cornerRadius="8dp" />

            </RelativeLayout>

        </FrameLayout>

        <!-- PDF Rendering View -->
        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/edu_bg"/>
    </LinearLayout>

    <!-- Progress Overlay: centered premium card -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_loading_card"
        android:elevation="12dp"
        android:gravity="center"
        android:minWidth="230dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="@color/edu_navy" />

        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Downloading PDF..."
            android:textColor="@color/edu_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
