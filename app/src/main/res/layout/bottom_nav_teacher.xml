<?xml version="1.0" encoding="utf-8"?>
<!-- Shared teacher bottom navigation: Generate, Papers, Home, Student Data, Awards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/navGenerate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/navGenerateIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/navGenerateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPapers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/navPapersIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/navPapersLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Papers"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/navHomeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navStudents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/navStudentsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/navStudentsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Data"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navAwards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/navAwardsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/navAwardsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Awards"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
