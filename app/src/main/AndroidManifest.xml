<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internet permission (Firebase, network access) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Storage permissions for PDF access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Package queries for social apps and YouTube deep linking -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".StudyPointApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_logo_studypoint"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_studypoint_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyPoint"
        android:usesCleartextTraffic="true">

        <!-- Added LoginActivity and made MainActivity the launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".OtpVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".BoardsActivity"
            android:exported="false" />

        <activity
            android:name=".BoardWebViewActivity"
            android:exported="false" />

        <activity
            android:name=".PdfActivity"
            android:exported="false" />
        <!-- Launcher / Welcome Activity -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />

        <!-- App Activities -->
        <activity
            android:name=".GradeSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".SubjectsActivity"
            android:exported="false" />
        <activity
            android:name=".MaterialSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".SectionsActivity"
            android:exported="false" />
        <activity
            android:name=".NotesActivity"
            android:exported="false" />
        <activity
            android:name=".PdfViewActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ChaptersActivity"
            android:exported="false" />
        <activity
            android:name=".BookActivity"
            android:exported="false" />
        <activity
            android:name=".KeyBookActivity"
            android:exported="false" />
        <activity
            android:name=".StudyMaterialActivity"
            android:exported="false" />
        <activity
            android:name=".ClassSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".HandwrittenNotesActivity"
            android:exported="false" />

        <!-- Embedded YouTube Video Player Activity -->
        <activity
            android:name=".YouTubePlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true"
            android:exported="false" />

        <!-- Practice Quiz Activities -->
        <activity
            android:name=".practicetest.QuizSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".practicetest.QuizActivity"
            android:exported="false" />
        <activity
            android:name=".practicetest.BookmarksActivity"
            android:exported="false"
            android:parentActivityName=".HomeActivity" />
        <service
            android:name=".StudyPointMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".practicetest.QuizResultActivity"
            android:exported="false" />
        <activity
            android:name=".practicetest.TestGeneratorActivity"
            android:exported="false" />
        <activity
            android:name=".practicetest.PaperGeneratorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Firebase / Google Services metadata -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/material_papers" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/primaryColor" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
